{"task":{"task_id":"multi_turn_miss_func_134","env_type":"bfcl","open_query":true,"metadata":{},"query":"Notify me if any of my watchlist stocks (NVDA, AAPL) experience a price change greater than 2%.","ground_truth":"# step0\nwatchlist = apis.tradingaccount.get_watchlist()\nprice_change_alerts = apis.tradingaccount.notify_price_change(stocks=['NVDA', 'AAPL'], threshold=2.0)\nif price_change_alerts['notification'] != 'No significant price changes':\n    print('Price change notification for stocks:', price_change_alerts['notification'])","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_param_53","env_type":"bfcl","open_query":true,"metadata":{},"query":"Set my vehicle's navigation to Elm Street, Springfield, MO, and activate cruise control at 60 mph maintaining a safe 50 meter distance from the next vehicle.","ground_truth":"# step 0: Set navigation to destination\napis.set_navigation(destination=\"Elm Street, Springfield, MO\")\n\n# step 1: Attempt to activate cruise control\napis.setCruiseControl(speed=60.0, activate=True, distanceToNextVehicle=50.0)\n# Observation: Error occurs because engine is not started\n\n# step 2: Attempt to start engine\napis.startEngine(ignitionMode=\"START\")\n# Observation: Error occurs because doors are not locked\n\n# step 3: Lock all doors\napis.lockDoors(unlock=False, door=[\"driver\", \"passenger\", \"rear_left\", \"rear_right\"])\n\n# step 4: Attempt to start engine again\napis.startEngine(ignitionMode=\"START\")\n# Observation: Error occurs because brake pedal is not pressed\n\n# step 5: Press brake pedal\napis.pressBrakePedal(pedalPosition=1.0)\n\n# step 6: Successfully start engine\napis.startEngine(ignitionMode=\"START\")\n\n# step 7: Activate cruise control successfully\napis.setCruiseControl(speed=60.0, activate=True, distanceToNextVehicle=50.0)","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_func_18","env_type":"bfcl","open_query":true,"metadata":{},"query":"Organize all `.txt` files in the `/Quarter1_Reports` directory into two subcategories: financial reports and historical documents.","ground_truth":"# step0\ndir_contents = apis.ls(a=True)['current_directory_content']\n# step1\napis.mkdir('Financial_Reports')\napis.mkdir('Historical_Files')\n# step2\nfor file in dir_contents:\n    if file.endswith('.txt'):\n        if 'report' in file:\n            apis.mv(source=file, destination='Financial_Reports')\n        elif 'History' in file:\n            apis.mv(source=file, destination='Historical_Files')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_base_140","env_type":"bfcl","open_query":true,"metadata":{},"query":"Filter stocks in my watchlist that have prices between $200 and $250, and show me the matching stocks.","ground_truth":"# step0\nfiltered_stocks = apis.filter_stocks_by_price(stocks=['NVDA'], min_price=200.0, max_price=250.0)\nprint(f'Filtered stocks: {filtered_stocks['filtered_stocks']}')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_param_22","env_type":"bfcl","open_query":true,"metadata":{},"query":"Duplicate 'project_analysis.txt' from the 'workspace' folder into 'project_archive', and confirm the operation is successful by verifying the new file exists in 'project_archive'.","ground_truth":"# step0\ncurrent_directory = apis.filesystem.get_current_directory()\nif apis.filesystem.list_directory(current_directory).contains('project_archive'):\n    apis.filesystem.copy_file('workspace/project_analysis.txt', 'project_archive/project_analysis.txt')\nif apis.filesystem.list_directory('project_archive').contains('project_analysis.txt'):\n    print('File successfully copied')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_param_161","env_type":"bfcl","open_query":true,"metadata":{},"query":"Calculate the average of my last five transactions: 45.99, 78.25, 102.50, 38.75, and 92.10.","ground_truth":"# step0\nnumbers = [45.99, 78.25, 102.50, 38.75, 92.10]\nmean_response = apis.mean(numbers=numbers)\nmean_value = mean_response.get('result')\nif mean_value:\n    print('Average transaction value:', mean_value)\nelse:\n    print('Failed to calculate the mean.')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
