{"task":{"task_id":"multi_turn_base_192","env_type":"bfcl","open_query":true,"metadata":{},"query":"Find the nearest airports for Rivermist and Stonebrook, then calculate the flight cost for economy travel between them on December 15, 2023.","ground_truth":"# step0\nnearest_airport_rivermist = apis.flight_booking.get_nearest_airport_by_city({'location': 'Rivermist'})\nnearest_airport_stonebrook = apis.flight_booking.get_nearest_airport_by_city({'location': 'Stonebrook'})\n\n# step1\nflight_cost = apis.flight_booking.get_flight_cost({'travel_from': nearest_airport_rivermist, 'travel_to': nearest_airport_stonebrook, 'travel_date': '2023-12-15', 'travel_class': 'economy'})\nprint(flight_cost)","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.9,"reward":null}
{"task":{"task_id":"multi_turn_base_63","env_type":"bfcl","open_query":true,"metadata":{},"query":"If my car's fuel tank is empty, how can I top it up to full capacity (50 gallons)?","ground_truth":"# step0\nfuel_level = apis.displayCarStatus(option='fuel')['fuelLevel']\n# step1\nif fuel_level < 50.0:\n    apis.fillFuelTank(fuelAmount=(50.0 - fuel_level))","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
