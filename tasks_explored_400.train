{"task":{"task_id":"multi_turn_miss_func_83","env_type":"bfcl","open_query":true,"metadata":{},"query":"Lock the driver and passenger doors while leaving the rear ones unlocked.","ground_truth":"# step0\nresult = apis.lockDoors(unlock=False, door=['driver', 'passenger'])\n# step1\nif result['lockStatus'] == 'locked':\n    print('Driver and passenger doors are locked successfully.')\nelse:\n    print('Failed to lock driver and passenger doors.')","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.8,"reward":null}
{"task":{"task_id":"multi_turn_long_context_75","env_type":"bfcl","open_query":true,"metadata":{},"query":"Activate cruise control at 60 km/h, ensuring a 50-meter distance to the next vehicle, and confirm that it is active.","ground_truth":"# step0: Attempt to activate cruise control at 60 mph with 50 meters distance to the next vehicle.\nresult = apis.setCruiseControl(speed=60.0, activate=True, distanceToNextVehicle=50.0)\nif 'error' in result:\n    # step1: Start the engine since cruise control requires the engine to be running.\n    result = apis.startEngine(ignitionMode='START')\n    if 'error' in result:\n        # step2: Lock all doors since the engine cannot start unless all doors are locked.\n        apis.lockDoors(unlock=False, door=['driver', 'passenger', 'rear_left', 'rear_right'])\n        # step3: Retry starting the engine.\n        result = apis.startEngine(ignitionMode='START')\n        if 'error' in result:\n            # step4: Press the brake pedal since the engine requires the brake pedal to be pressed to start.\n            apis.pressBrakePedal(pedalPosition=1.0)\n            # step5: Retry starting the engine.\n            apis.startEngine(ignitionMode='START')\n\n# step6: Activate cruise control again after successfully starting the engine.\napis.setCruiseControl(speed=60.0, activate=True, distanceToNextVehicle=50.0)","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.9,"reward":null}
{"task":{"task_id":"multi_turn_miss_param_132","env_type":"bfcl","open_query":true,"metadata":{},"query":"Place a Buy order for NVDA with 10 shares at $220.34 and retrieve its status.","ground_truth":"# step0\norder = apis.trading_account.place_order(order_type='Buy', symbol='NVDA', price=220.34, amount=10)\n# step1\norder_details = apis.trading_account.get_order_details(order_id=order['order_id'])\nprint(order_details)","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
