{"task":{"task_id":"multi_turn_base_64","env_type":"bfcl","open_query":true,"metadata":{},"query":"Start my vehicle by pressing the brake, then use cruise control at 70 mph with a 50-meter distance to the next vehicle.","ground_truth":"# step0\napis.vehicle.pressBrakePedal(pedalPosition=1.0)\n# step1\napis.vehicle.startEngine(ignitionMode='START')\n# step2\ncruise_control = apis.vehicle.setCruiseControl(speed=70, activate=True, distanceToNextVehicle=50.0)\nif cruise_control['cruiseStatus'] == 'active':\n    print(f'Cruise control active at {cruise_control['currentSpeed']} mph with {cruise_control['distanceToNextVehicle']} meters distance.')","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.8,"reward":null}
{"task":{"task_id":"multi_turn_base_54","env_type":"bfcl","open_query":true,"metadata":{},"query":"Lower the car’s interior temperature to 20°C and switch the climate mode to 'cool'.","ground_truth":"# step0\nresult = apis.adjustClimateControl(temperature=20.0, mode='cool')\n# step1\nif result['currentACTemperature'] == 20.0 and result['climateMode'] == 'cool':\n    print('Success')\nelse:\n    print('Failure')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_func_187","env_type":"bfcl","open_query":true,"metadata":{},"query":"Create a customer support ticket to request documentation for my canceled booking ID 4191922.","ground_truth":"# step0\nlogin_response = apis.ticket_login(username='Alice', password='securepassword123')\nif not login_response['success']:\n    raise Exception('Login failed.')\n# step1\nticket_response = apis.create_ticket(title='Issue with booking cancellation',\n                                     description='I canceled my booking ID 4191922 but need documentation for financial tracking. Could you assist?',\n                                     priority=3)\nreturn ticket_response","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_long_context_66","env_type":"bfcl","open_query":true,"metadata":{},"query":"Prepare my car for use: lock doors, engage parking brake, and start the engine in START mode.","ground_truth":"# step0\napis.lockDoors(unlock=False, door=['driver','passenger','rear_left','rear_right'])\n\n# step1\napis.activateParkingBrake(mode='engage')\n\n# step2\ntry:\n    apis.startEngine(ignitionMode='START')\nexcept Exception as e:\n    # If brake pedal needs to be pressed\n    apis.pressBrakePedal(pedalPosition=1.0)\n    apis.startEngine(ignitionMode='START')","evaluator":"llm-binary-gt-no_constraint"},"confidence":1.0,"reward":null}
{"task":{"task_id":"multi_turn_miss_param_71","env_type":"bfcl","open_query":true,"metadata":{},"query":"Lock all of my vehicle's doors to meet safety requirements for starting the engine","ground_truth":"# step0\nlockConfirmation = apis.vehicle.lockDoors(unlock=False, door=['driver','passenger','rear_left','rear_right']).lockStatus\nif lockConfirmation == 'locked':\n    print('All doors successfully locked')\nelse:\n    print('Failed to lock all doors')","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.9,"reward":null}
{"task":{"task_id":"multi_turn_long_context_77","env_type":"bfcl","open_query":true,"metadata":{},"query":"Post a tweet to share my genealogy journey and boost its visibility through replies and retweets.","ground_truth":"# step0\ntweet = apis.post_tweet(content='Setting forth on an exciting quest from San Francisco to Stonebrook to uncover ancestral stories!', tags=['#GenealogyAdventure', '#FamilyHistory'])\n# step1\ncommentStatus = apis.comment(tweet_id=tweet['id'], comment_content='What a thrilling journey for family history and genealogy adventures! Can't wait to see what you uncover!')\n# step2\nretweetStatus = apis.retweet(tweet_id=tweet['id'])","evaluator":"llm-binary-gt-no_constraint"},"confidence":0.85,"reward":null}
